#!/bin/bash

CONFIG_DIR="$HOME/.config/police"
mkdir -p "$CONFIG_DIR"

error() {
  echo "Error: $1" >&2
  exit 1
}

warn() {
  echo "Warning: $1" >&2
}

case "$1" in
  -l)
    systemctl --user list-units --type=service | grep 'police@'
    ;;

  -s)
    NAME="$2"
    [[ -z "$NAME" ]] && error "Missing service name"

    systemctl --user stop "police@$NAME.service"
    systemctl --user disable "police@$NAME.service"
    rm -f "$CONFIG_DIR/$NAME"
    ;;

  -r)
    NAME="$2"
    KEY="$3"
    LOCK="$4"

    [[ -z "$NAME" || -z "$KEY" || -z "$LOCK" ]] && error "Usage: police -r <name> <key> <lock>"

    KEY="$(realpath -m "$KEY")"
    LOCK="$(realpath -m "$LOCK")"

    [[ "$KEY" == "$LOCK" ]] && error "key and lock cannot be the same"

    [[ ! -e "$KEY" ]] && warn "key does not exist"
    [[ ! -e "$LOCK" ]] && warn "lock does not exist"

    echo "reverse::$KEY::$LOCK" > "$CONFIG_DIR/$NAME"

    systemctl --user daemon-reload
    systemctl --user enable --now "police@$NAME.service"
    ;;

  *)
    NAME="$1"
    KEY="$2"
    LOCK="$3"

    [[ -z "$NAME" || -z "$KEY" || -z "$LOCK" ]] && error "Usage: police <name> <key> <lock>"

    KEY="$(realpath -m "$KEY")"
    LOCK="$(realpath -m "$LOCK")"

    [[ "$KEY" == "$LOCK" ]] && error "key and lock cannot be the same"

    [[ ! -e "$KEY" ]] && warn "key does not exist"
    [[ ! -e "$LOCK" ]] && warn "lock does not exist"

    echo "normal::$KEY::$LOCK" > "$CONFIG_DIR/$NAME"

    systemctl --user daemon-reload
    systemctl --user enable --now "police@$NAME.service"
    ;;
esac